# AgentQL Pro API Configuration
# Used for intelligent web scraping of municipal zoning codes
# Do NOT commit actual keys - use environment variables in production

# AgentQL Pro API Key (set via environment variable)
AGENTQL_API_KEY=${AGENTQL_API_KEY}

# AgentQL Configuration
AGENTQL_BASE_URL=https://api.agentql.com
AGENTQL_TIMEOUT=30
AGENTQL_MAX_RETRIES=3
AGENTQL_RATE_LIMIT_DELAY=2
